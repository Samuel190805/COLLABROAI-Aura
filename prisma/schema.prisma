datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  jobs          Job[]
  mediaAssets   MediaAsset[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id          String       @id @default(cuid())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String       // STEM_SEPARATION | MEDIA_DOWNLOAD | TRANSLATE_SPEAK
  status      String       @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  stage       String       @default("ANALYSIS") // 4-stage SSE pattern: ANALYSIS | MODEL_INFERENCE | STEM_RECONSTRUCTION | EXPORT, etc.
  progress    Float        @default(0)
  message     String?
  inputParams String       @default("{}") // JSON string of parameters (sourceUrl, fileName, options, etc.)
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?
  mediaAssets MediaAsset[]

  @@index([userId])
  @@index([status])
}

model MediaAsset {
  id           String   @id @default(cuid())
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  kind         String   // ORIGINAL | STEM_VOCALS | STEM_INSTRUMENT | DOWNLOAD_AUDIO | DOWNLOAD_VIDEO | TRANSLATED_AUDIO | MASHUP
  filePath     String
  mimeType     String
  format       String   // mp3 | wav | flac | mp4 | etc.
  codec        String?  // aac | pcm_s16le | h264 | etc.
  duration     Float?   // in seconds
  sizeBytes    Int?
  waveformData String?  // JSON string array of peak values [0..1]
  metadata     String?  // JSON string of additional metadata
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([userId])
  @@index([kind])
}
